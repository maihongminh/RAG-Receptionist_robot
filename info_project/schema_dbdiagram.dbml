// Converted from schema.sql for dbdiagram.io
// Source SQL had no explicit foreign key constraints; Ref lines below are inferred from common *_id naming.
Project robo_raw {
  database_type: "PostgreSQL"
  Note: "Raw Excel import schema converted to DBML. Most columns are TEXT by design."
}

